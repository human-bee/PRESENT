# The local Codex ChatGPT subscription supplies Spark and Astra.
# Install and sign in to Codex; no model API key is needed for those two providers.
PRESENT_PORT=4317
# CODEX_CLI_PATH=/absolute/path/to/codex

# Voice uses GPT-Live WebRTC with a delegated Responses backend.
OPENAI_API_KEY=

# Human camera, microphone, and screen sharing.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional separate fast inference account.
CEREBRAS_API_KEY=

# Optional read-only member context and external live chat for RoomOS.
LINEAR_API_KEY=
YOUTUBE_API_KEY=
