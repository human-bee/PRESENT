# The authenticated Codex subscription discovers available Sol 6.1, Luna 6 and Astra 6.
# Install and sign in to Codex. New ordinary work defaults to Sol 6.1.
# Saved jobs retain their exact model. Retired or unknown resumes need explicit recovery.
PRESENT_PORT=4317
# CODEX_CLI_PATH=/absolute/path/to/codex

# Voice uses GPT-Live WebRTC with a delegated Responses backend.
OPENAI_API_KEY=

# Human camera, microphone, and screen sharing.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional separate fast inference account.
CEREBRAS_API_KEY=

# Optional bounded JEV routing for standard tools and selected-object changes.
TYPESAFE_API_KEY=

# Network hosting requires the signed invite profile and durable storage.
# See docs/cloud-readiness.md before setting these on a hosted service.
# PRESENT_ACCESS_MODE=invite
# PRESENT_HOST=0.0.0.0
# PRESENT_ACCESS_ORIGIN=https://your-canonical-host.example
# PRESENT_ACCESS_SECRET=operator-supplied-stable-secret-at-least-32-bytes
# PRESENT_DATA_DIRECTORY=/private-durable-volume/present
# PRESENT_ACCESS_DIRECTORY=/private-durable-volume/present/access

# Optional read-only member context and external live chat for RoomOS.
LINEAR_API_KEY=
YOUTUBE_API_KEY=
