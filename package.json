    "@tldraw/tlschema": "5.4.0",
    "dotenv": "^16.5.0",
    "image-size": "^2.0.4",
    "ipaddr.js": "^2.2.0",
    "livekit-client": "2.20.1",
    "livekit-server-sdk": "2.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tldraw": "5.4.0",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.3",
